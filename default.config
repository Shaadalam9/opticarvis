{
    "data": "data",
    "mapping": "mapping.csv",
    "output_dir": "_output",
    "workflow_outputs": "workflow_outputs",
    "alpamayo_outputs": "alpamayo_outputs",
    "alpamayo_json_dir": "alpamayo_outputs/alpamayo_json",
    "videos": "videos",
    "VIDEO_BASE_URL": "https://files.mobility-squad.com/",
    "DELETE_FTP_VIDEOS_AFTER_USE": false,
    "BATCH_CHUNK_SIZE": 5,
    "CLIP_LENGTH_S": 30,
    "STRIDE_S": 45,
    "CITY_LIMIT": 0,
    "CITY_FOOTAGE_S": 3600,
    "ONE_CLIP_PER_CITY": false,
    "USE_CANDIDATE_INDEX": true,
    "CANDIDATE_INDEX_PARQUET": "workflow_outputs/candidate_index.parquet",
    "CANDIDATE_INDEX_STRIDE_S": 5,
    "CANDIDATE_EVENT_SEPARATION_S": 30,
    "CANDIDATE_INDEX_MAX_WINDOWS_PER_VIDEO": 60,
    "CANDIDATE_INDEX_MIN_GAP_S": 30,
    "CANDIDATE_INDEX_FALLBACK_WINDOWS_PER_VIDEO": 10,
    "PRINT_PROGRESS_EVERY_N_CITIES": 100,
    "clip_jobs_jsonl": "workflow_outputs/clip_jobs.jsonl",
    "master_clip_index_jsonl": "workflow_outputs/master_clip_index.jsonl",
    "batch_pipeline_script": "src/batch_corrected_pipeline.py",
    "final_render_dir": "workflow_outputs/final_renders",
    "CITY_RUNNER_MAX_CITIES": 0,
    "SINGLE_PIPELINE_SCRIPT": "src/run_corrected_pipeline.py",
    "EXTRACT_CLIPS": true,
    "RUN_ALPAMAYO": true,
    "SKIP_EXISTING_STATE": false,
    "STOP_ON_JOB_FAILURE": false,
    "MAX_CONSECUTIVE_FAILURES": 5,
    "GATE_BATCH": true,
    "BATCH_H264": true,
    "AUTO_CALIBRATE": true,
    "CLIPS_PER_CITY": 1,
    "WINDOWS_PER_CITY": 10,
    "DOWNLOAD_MISSING_SOURCE_VIDEOS": true,
    "FTP_ALIASES": ["tue1", "tue2", "tue3", "tue4", "tue5"],
    "FTP_CRAWL_PAGE_LIMIT": 500,
    "FTP_TIMEOUT_SECONDS": 20,
    "WHEN_START_LOCAL_S": 12.67,
    "WHEN_END_LOCAL_S": 15.6,
    "OOM_FREE_ALPAMAYO_REPO": "external/oom-free-alpamayo",
    "ALPAMAYO_SCRIPT": "external/oom-free-alpamayo/scripts/infer_crowd_clip.py",
    "ALPAMAYO_CONFIG": "config_5080_16gb.json",
    "ALPAMAYO_BACKEND": "alpamayo_r1",
    "ALPAMAYO2_SUPER_MODEL_ID": "nvidia/Alpamayo2-Super",
    "ALPAMAYO2_SUPER_REPO": "external/alpamayo2",
    "ALPAMAYO2_SUPER_PYTHON": "external/alpamayo2/.venv/bin/python",
    "ALPAMAYO2_SUPER_ADAPTER_SCRIPT": "src/alpamayo2_super_adapter.py",
    "RENDER_CONFIG": "configs/render_default.json",
    "TRACKER_NAME": "bytetrack.yaml",
    "RIBBON_SOURCE": "perception",
    "PLANNER_LATERAL_SIGN": -1,
    "USE_EGO_LOOKAHEAD": false,
    "USE_VO_TRAJECTORY": false,
    "LANE_SOURCE": "ufldv2",
    "USE_LANE_CURVE": true,
    "DIRECT_FUTURE_PATH": true,
    "USE_FUTURE_ANCHOR": true,
    "FUTURE_ANCHOR_JSON": "",
    "DUMP_GEOMETRY": true
}
